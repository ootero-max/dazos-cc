# ── Core ──────────────────────────────────────────────────────────────────────
# Where JSON stores live. On Render set this to the persistent disk (/data).
# Locally, leave unset to use the repo directory.
#DATA_DIR=/data

PORT=3000
WEB_APP_URL=http://localhost:3000
SESSION_SECRET=change-me

# Comma-separated bootstrap admins — always admins, always able to log in.
BOOTSTRAP_ADMINS=you@dazos.com

# Optional: seed the access list on first boot (admins manage it in Settings after that).
#ALLOWED_EMAILS=teammate@dazos.com

# ── Google OAuth (required for login) ────────────────────────────────────────
# Google Cloud Console → Credentials → OAuth client (Web).
# Authorized redirect URI: {WEB_APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LOCAL DEV ONLY: skip Google login and run as DEV_USER_EMAIL (admin).
# Never set in production.
#DEV_NO_AUTH=1
#DEV_USER_EMAIL=you@dazos.com

# ── Jira (optional) ───────────────────────────────────────────────────────────
# Users connect their own Jira account in the profile menu (email + API token).
# These env creds are only the fallback for non-interactive callers (crons).
JIRA_SITE_URL=https://dazos.atlassian.net
JIRA_CLOUD_ID=ceba56f1-ef80-41bb-b30f-102b42d9b7a0
#JIRA_EMAIL=
#JIRA_API_TOKEN=

# ── Salesforce (optional) ─────────────────────────────────────────────────────
# Connected App with OAuth2 client-credentials flow enabled (run-as user set).
#SALESFORCE_INSTANCE_URL=https://yourorg.my.salesforce.com
#SALESFORCE_CLIENT_ID=
#SALESFORCE_CLIENT_SECRET=

# ── Slack (optional) ──────────────────────────────────────────────────────────
# Bot token with chat:write, im:write, users:read, users:read.email.
#SLACK_BOT_TOKEN=

# ── Claude AI (optional) ──────────────────────────────────────────────────────
#ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5-20250929
